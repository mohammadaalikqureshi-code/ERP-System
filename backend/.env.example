# Copy to .env and fill in. Values shown are development defaults.
# The app refuses to start in production while the placeholders are still here.

# ---------------------------------------------------------------- general
ENVIRONMENT=development           # development | staging | production
DEBUG=True
APP_NAME=MediCare ERP
API_V1_STR=/api/v1

# ------------------------------------------------------------------- auth
# Generate each of these separately:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Encrypts patient identifiers and stored API keys. Required in production.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --------------------------------------------------------------- database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinic_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinic_erp
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------ redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -------------------------------------------------------------------- web
# Comma-separated. Must be explicit origins in production — no "*".
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------- load & rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=300         # per IP, all endpoints
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_AI_PER_MINUTE=20
MAX_CONCURRENT_REQUESTS=200       # beyond this, requests get 503 + Retry-After
SLOW_REQUEST_MS=1000              # requests slower than this are logged

# ------------------------------------------------------------- pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------- caching
CACHE_ENABLED=True
CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------- uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.dcm,.doc,.docx

# -------------------------------------------------------------------- OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Returns the OTP in the API response so you can sign in without an SMS
# gateway. Forced off in production.
OTP_DEBUG_RETURN=True

# ---------------------------------------------------------------- billing
DEFAULT_GST_PERCENT=18.0
CURRENCY=INR

# --------------------------------------------------------------------- AI
AI_ENABLED=True
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
# Optional platform-wide key. A clinic's own key (Settings -> API Keys) wins.
# Leave empty and the AI features simply report themselves as unavailable.
AI_API_KEY=
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=60
AI_CHAT_HISTORY_LIMIT=12

# ------------------------------------------------- patient notifications
WHATSAPP_PROVIDER=mock            # mock | meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER=mock                 # mock | msg91
MSG91_API_KEY=
MSG91_SENDER_ID=MEDCRE
